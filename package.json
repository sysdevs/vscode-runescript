    "configuration": {
      "title": "RuneScript",
      "properties": {
        "runescript.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to a runescript-lsp binary. Empty uses the one shipped with the extension, then PATH."
        },
        "runescript.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication with the language server."
        },
        "runescript.diagnostics.configWarnings": {
          "type": "boolean",
          "default": true,
          "description": "Report unknown keys, bad values and unknown names in config files."
        },
        "runescript.contentRoot": {
          "type": "string",
          "default": "",
          "description": "The Content folder the interface editor reads sprites, fonts and pack/interface.pack from. Empty finds the first folder above the .if file holding pack/interface.pack. Relative paths start at the first workspace folder."
        },
        "runescript.interfaceEditor.openWith": {
          "type": "string",
          "enum": [
            "visual",
            "text"
          ],
          "enumDescriptions": [
            "Open .if files in the visual interface editor.",
            "Open .if files as text."
          ],
          "default": "visual",
          "description": "How .if files open. Setting it writes workbench.editorAssociations[\"*.if\"] at the same scope."
        },
        "runescript.interfaceEditor.zoom": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "default": 2,
          "description": "Zoom a newly opened interface editor starts at."
        },
        "runescript.interfaceEditor.gridSize": {
          "type": "integer",
          "minimum": 1,
          "default": 8,
          "description": "Grid spacing in pixels for the interface editor's grid and grid snapping."
        },
        "runescript.interfaceEditor.grid": {
          "type": "boolean",
          "default": false,
          "description": "Whether a newly opened interface editor starts with the grid (and grid snapping) on."
        },
        "runescript.interfaceEditor.smartGuides": {
          "type": "boolean",
          "default": true,
          "description": "Whether a newly opened interface editor starts with smart guides (snap to layer and sibling edges and centres) on."
        }
      }
    },
    "commands": [
      {
        "command": "runescript.restartServer",
        "title": "Restart Language Server",
        "category": "RuneScript"
      },
      {
        "command": "runescript.ifOpenVisual",
        "title": "Open Interface Editor",
        "category": "RuneScript",
        "icon": "$(preview)"
      },
      {
        "command": "runescript.ifOpenText",
        "title": "Open as Text",
        "category": "RuneScript",
        "icon": "$(go-to-file)"
      },
      {
        "command": "runescript.ifNew",
        "title": "New Interface…",
        "category": "RuneScript",
        "icon": "$(new-file)"
      },
      {
        "command": "runescript.modelPreview",
        "title": "Open Model Preview to the Side",
        "category": "RuneScript",
        "icon": "$(open-preview)"
      }
    ],
    "customEditors": [
      {
        "viewType": "runescript.ifEditor",
        "displayName": "Interface Editor",
        "selector": [
          {
            "filenamePattern": "*.if"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "runescript.ifOpenVisual",
          "when": "resourceExtname == .if && activeCustomEditorId != runescript.ifEditor",
          "group": "navigation"
        },
        {
          "command": "runescript.ifOpenText",
          "when": "activeCustomEditorId == runescript.ifEditor",
          "group": "navigation"
        },
        {
          "command": "runescript.modelPreview",
          "when": "editorLangId =~ /^runescript-(npc|obj|loc|idk|spotanim)$/",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "runescript.ifNew",
          "when": "explorerResourceIsFolder",
          "group": "navigation@10"
        }
      ]
    }
  },
  "scripts": {
    "gen": "cd ../ares-compiler && cargo run --release --example dump_syntax > ../vscode-runescript/data/syntax.json && cd ../vscode-runescript && node scripts/gen-grammar.mjs",
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "test": "npm run compile && node --test test/scan.test.js test/ifedit.test.js test/ifedit-render.test.js test/modelview.test.js test/modelview-types.test.js test/modelview-controls.test.js test/modelview-colours.test.js && vscode-tmgrammar-snap \"test/grammar/*.*\"",
    "snap": "vscode-tmgrammar-snap --updateSnapshot \"test/grammar/*.*\"",
    "package": "npm run compile && npm run build-server && vsce package --target win32-x64",
    "build-server": "cd ../runescript-lsp && cargo build --release && cd ../vscode-runescript && node -e \"require('fs').mkdirSync('bin',{recursive:true});require('fs').copyFileSync('../runescript-lsp/target/release/runescript-lsp.exe','bin/runescript-lsp.exe')\""
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.1.0",
    "typescript": "^5.4.0",
    "vscode-tmgrammar-test": "^0.1.3"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
