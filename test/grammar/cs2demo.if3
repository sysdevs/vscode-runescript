[frame]
type=layer
width=16
height=16
widthmode=minus
heightmode=minus
xmode=abs_centre
ymode=abs_centre

[bg]
type=rectangle
width=0
height=0
widthmode=minus
heightmode=minus
layer=frame
colour=0x3e3529
fill=yes
trans=64

[border]
type=rectangle
width=0
height=0
widthmode=minus
heightmode=minus
layer=frame
colour=0x7a6a4f

[title]
type=text
y=6
width=0
height=16
widthmode=minus
layer=frame
textfont=b12_full
textalignh=centre
textshadow=yes
colour=0xff981f
onload=cs2demo_init(event_com)

[rule]
type=line
x=8
y=26
width=16
height=0
widthmode=minus
layer=frame
colour=0x7a6a4f
linewid=1

[clock]
type=text
x=10
y=34
width=200
height=14
layer=frame
textfont=p11_full
colour=0xffffff
ontimer=cs2demo_clock(event_com)

[clicks]
type=text
x=10
y=34
width=200
height=14
xmode=abs_right
layer=frame
textfont=p11_full
textalignh=right
colour=0xffffff
onload=cs2demo_count(event_com)
onvartransmit=cs2demo_count(event_com){cs2demo_clicks}

[icon]
type=graphic
x=10
y=54
width=6
height=6
layer=frame
graphic=mapdots

[list]
type=layer
x=10
y=70
width=20
height=60
widthmode=minus
heightmode=minus
layer=frame
scrollheight=200
onload=cs2demo_list(event_com)
oninvtransmit=cs2demo_list(event_com){inv}

[ok]
type=text
x=0
y=8
width=80
height=18
xmode=abs_centre
ymode=abs_bottom
layer=frame
textfont=p12_full
textalignh=centre
textalignv=centre
colour=0xff981f
text=Click me
op1=Ok
opbase=Demo
transmitop=1
onop=cs2demo_click(event_com)
onmouseover=cs2demo_hover(event_com, true)
onmouseleave=cs2demo_hover(event_com, false)
